# ============================================================================
# Poros — contoh konfigurasi environment.
#
# Salin file ini menjadi `.env` (di folder backend/), lalu sesuaikan seperlunya:
#     copy .env.example .env      (Windows)
#     cp   .env.example .env      (Linux / Mac)
#
# `.env` TIDAK ikut ke Git (lihat .gitignore) — aman untuk secret dev.
# Aturan urutan (yang di atas menang): variabel di shell  >  file .env  >  default kode.
# Baris berawalan `#` = nonaktif (pakai default kode). Hapus `#` untuk mengaktifkan.
# ============================================================================

# --- Metadata store (WAJIB: Postgres harus nyala) ---------------------------
# DSN Postgres untuk menyimpan tenant / role / API key / chunk dokumen / memory.
# Platform yang hanya menyediakan DATABASE_URL juga didukung; ADMIN_DB_URL menang
# bila keduanya tersedia.
# Tidak ada password bawaan di kode. Ganti placeholder ini sebelum backend pertama
# kali dijalankan; simpan nilai riil hanya di `.env` lokal / secret manager.
ADMIN_DB_URL=
# ADMIN_DB_SCHEMA=public
# Wajib 1 di production. Pasang dengan role aplikasi non-superuser/non-BYPASSRLS.
# ADMIN_DB_RLS=1

# --- Kunci admin console (header X-Admin-Key untuk login) -------------------
# Biarkan kosong saat pertama kali: run_backend.bat membuat nilai acak unik di .env.
ADMIN_KEY=

# --- Identitas end-user / JWT (Pattern B di endpoint /v1) -------------------
# Fallback HS global HANYA untuk local/dev. Production menolaknya: konfigurasi setiap
# tenant dengan JWKS URL/public key + algoritma RS*/ES* + issuer + audience di tab App Key.
JWT_SECRET=
# JWT_LEEWAY_SEC=120
# JWT_JWKS_ALLOW_PRIVATE_HOSTS=0        # 1 hanya untuk IdP internal yang memang disetujui
# PENGECUALIAN STAGING SAJA: izinkan HS256 per tenant di APP_ENV=production.
# Tetap wajib secret tenant + issuer + audience; fallback JWT_SECRET global tidak dipakai.
# Jangan aktifkan pada production riil.
# JWT_ALLOW_HS256_STAGING=0

# Pepper HMAC untuk hash API key di metadata DB. Harus stabil; menggantinya akan
# membuat key consumer lama tidak dapat diverifikasi. Launcher lokal mengisinya.
API_KEY_PEPPER=

# --- Apps Gateway (opsional: console di belakang gerbang login perusahaan) --
# Kalau console dijalankan DI BELAKANG Apps Gateway, gerbang yang mengurus login
# lalu meneruskan email user yang sudah login lewat header X-User-Id. Console tidak
# bikin login sendiri — cukup percaya header itu. NYALAKAN HANYA bila service ini
# sudah terisolasi jaringan (hanya gerbang yang bisa menjangkaunya); kalau tidak,
# klien bisa memalsukan X-User-Id. Default OFF = pakai login bawaan (email+password/SSO).
# APPS_GATEWAY_TRUST_HEADER=1
# APPS_GATEWAY_NETWORK_ISOLATED=1       # wajib bersama TRUST_HEADER di production
# APPS_GATEWAY_AUTO_PROVISION=1          # 0 = admin harus membuat akun dulu (tanpa auto-buat)
# APPS_GATEWAY_DEFAULT_ROLE=tenant_manager   # role untuk user baru dari gateway (bukan 'admin')

# --- SSO standalone Google (opsional; gratis untuk test lokal) --------------
# Buat OAuth Client bertipe "Web application" di Google Auth Platform.
# Authorized redirect URI harus PERSIS:
#   http://localhost:8000/auth/sso/google/callback
# GOOGLE_SSO_CLIENT_ID=
# GOOGLE_SSO_CLIENT_SECRET=
# GOOGLE_SSO_REDIRECT_URI=http://localhost:8000/auth/sso/google/callback
# GOOGLE_SSO_ALLOWED_DOMAINS=                 # contoh: example.com; kosong = akun Google mana pun
# GOOGLE_SSO_AUTO_PROVISION=1                 # 0 = akun harus dibuat dulu di Console Users
# GOOGLE_SSO_DEFAULT_ROLE=tenant_manager
# SSO_CLOCK_SKEW_SEC=120                       # toleransi jam host vs Google/Microsoft; maksimum 300
# CONSOLE_URL=http://localhost:5173

# --- SSO standalone Microsoft (opsional) ------------------------------------
# MS_SSO_CLIENT_ID=
# MS_SSO_CLIENT_SECRET=
# MS_SSO_TENANT_ID=organizations
# MS_SSO_REDIRECT_URI=http://localhost:8000/auth/sso/microsoft/callback
# MS_SSO_AUTO_PROVISION=1
# MS_SSO_DEFAULT_ROLE=tenant_manager

# --- Mode aplikasi ----------------------------------------------------------
# WAJIB DIISI, dan tidak di-komentari: default-nya sekarang DIBALIK. Kalau APP_ENV tidak
# diset (atau nilainya tidak dikenal), aplikasi menganggap dirinya deployment sungguhan dan
# MENOLAK START selama masih ada default dev — dulu variabel yang lupa diisi justru
# mematikan semua pemeriksaan tanpa suara.
#   dev | local | test | staging -> longgar, hanya peringatan
#   production | prod            -> ketat
# staging sengaja longgar: mode ketat menuntut kolektor audit HTTPS di luar host
# (ADMIN_AUDIT_SINK_URL) dan ADMIN_DB_RLS=1, dan staging tidak punya keduanya — sempat
# membuat pod menolak start padahal APP_ENV-nya tidak berubah, hanya artinya yang berubah.
# Sebelum menaikkan environment apa pun ke ketat, cek dulu GET /admin/security-status pada
# instance yang masih longgar: ia menampilkan tepat apa yang akan menolak start.
APP_ENV=dev
# CONSOLE_SESSION_HOURS=12              # production maksimum 24
# LOGIN_IP_MAX_FAILURES=20              # shared IP bucket; account bucket tetap 5
# CONSOLE_COOKIE_SECURE=1               # otomatis 1 di production; lokal HTTP biarkan default

# --- Hard budget LLM --------------------------------------------------------
# Sebelum chat, server mereservasi headroom ini secara atomik. Naikkan bila satu
# analisis termahal Anda bisa melebihi nilai ini; budget 0/kosong = unlimited.
# BUDGET_RESERVE_USD_PER_CHAT=0.25
# BUDGET_RESERVE_USD_PER_LLM_CALL=0.05  # background/admin call tanpa reservasi chat

# --- Deep Analysis + validasi web (opsional) --------------------------------
# Pertanyaan analitik kompleks otomatis memakai agen riset adaptif:
# inspect katalog -> jalankan SQL governed -> observasi -> replan -> critic -> synthesis.
# Consumer juga bisa meminta analysis_mode=deep|fast. Nilai di bawah adalah circuit
# breaker operasional, BUKAN jumlah langkah yang wajib dijalankan.
# DEEP_RESEARCH_MAX_ROUNDS=24
# DEEP_RESEARCH_MAX_SQL=18
# DEEP_RESEARCH_MAX_CATALOG=14
# DEEP_RESEARCH_MAX_DISCOVERY=6
# DEEP_RESEARCH_MAX_PROFILE=8
# DEEP_RESEARCH_MAX_SEMANTIC=8
# DEEP_RESEARCH_MAX_HYPOTHESES=16
# DEEP_RESEARCH_MAX_DOCS=6
# DEEP_RESEARCH_MAX_WEB=4
# DEEP_RESEARCH_CRITIC_ROUNDS=2
# DEEP_RESEARCH_MAX_SECONDS=600
# DISCOVERY_CACHE_TTL_SEC=180
# PROFILE_MAX_SAMPLE_ROWS=300
# PROFILE_MAX_COLUMNS=24
#
# Default `auto` memakai API key provider OpenAI yang SUDAH tersimpan per tenant
# di Vault/Fernet dan memanggil Responses API dengan tool `web_search`; tidak perlu
# OPENAI_API_KEY kedua di .env. SQL internal tetap sumber kebenaran perusahaan.
# WEB_RESEARCH_ENABLED=auto              # 0=selalu mati
# WEB_RESEARCH_PROVIDER=auto             # auto | openai | gemini | off
# OPENAI_WEB_SEARCH_MODEL=               # kosong = Primary tenant, lalu Simple/Fallback
# Gemini tetap tersedia sebagai fallback opsional untuk tenant tanpa provider OpenAI:
# GEMINI_SEARCH_API_KEY=
# GEMINI_SEARCH_MODEL=gemini-2.5-flash
# WEB_RESEARCH_TIMEOUT_SEC=60

# --- Audit perubahan admin (wajib production) -------------------------------
# Event lokal append-only memakai hash-chain; copy ditandatangani dikirim ke collector.
# ADMIN_AUDIT_CHAIN_KEY=
# ADMIN_AUDIT_SINK_URL=https://audit-collector.example.com/poros
# ADMIN_AUDIT_SINK_HMAC_KEY=
# ADMIN_AUDIT_SINK_TIMEOUT_SEC=5
# ADMIN_AUDIT_RETRY_SEC=60               # retry outbox gagal, juga tanpa mutation baru

# Long-running operations (DB scan, document embedding, auto-enrich, deep research)
# are persisted in PostgreSQL and polled through short HTTP requests, so an edge
# gateway timeout never owns their lifetime.
# JOB_WORKERS=2                           # per Poros process; DB claim prevents double-run
# JOB_INTERACTIVE_WORKERS=1               # of those, RESERVED for chat (default: half).
#                                         # A reindex/enrich can then never park a question;
#                                         # the rest work batch first, chat when idle.
#                                         # 1 worker total = plain FIFO (nothing to reserve).
# JOB_LEASE_SEC=300                       # a job whose pod died hard is reclaimed after this (a heartbeat renews live ones; SIGTERM hands jobs back at once)
# JOB_RETENTION_HOURS=168                 # result/progress job disimpan 7 hari
# LLM_TIMEOUT_SEC=600                     # ceiling per provider call — a hung connection
#                                         # must free its job worker, never pin it forever
# FOLLOWUP_REWRITE=1                      # 0 = never rewrite a short follow-up ("show me
#                                         # for each client") into a standalone question
#                                         # built from the user's earlier turns (one cheap
#                                         # model call, token-gated, re-screened)
# CHAT_AGENT_MAX_TURNS=10                 # tool turns the chat agent may take (2-30)
# CHAT_AGENT_TURN_TOKENS=4096             # output cap per agent turn (reasoning models
#                                         # think inside it)
# CHAT_ANSWER_MAX_TOKENS=4096             # output cap of the streamed answer written
#                                         # after the agent explored (deep mode: 7000)

# --- Original uploaded documents (clickable citations) -----------------------
# db = simpan file asli (terenkripsi AES-GCM per tenant) di tabel Postgres
# document_files -> pod STATELESS: PVC dokumen bisa dilepas, replica bisa >1 /
# autoscale. disk (default) = perilaku lama di DOCS_FILES_DIR. Baca mengikuti REF
# per dokumen (bukan env), jadi flip/rollback tidak merusak baris lama dua arah.
# Migrasi file lama: python -m scripts.migrate_files_to_db --apply (di pod).
# FILES_BACKEND=db

# --- Provider Codex (eksekusi subprocess di host backend) --------------------
# Provider `codex` BUKAN panggilan HTTP biasa: ia menjalankan coding agent sebagai proses
# anak di host ini, dan prompt-nya berisi teks chat pengguna. Karena memilihnya hanya
# butuh satu POST /admin/models, keputusan mengizinkannya ada di operator, bukan di
# tenant manager. Default MATI. Subprocess-nya tetap menerima environment ter-allowlist
# saja (lihat app/llm/subprocess_env.py), jadi rahasia platform tidak pernah ikut.
# ALLOW_CODEX_PROVIDER=0

# --- Enkripsi secret at-rest ------------------------------------------------
# fernet (default, enkripsi lokal) | vault (HashiCorp Vault / OpenBao KV v2)
# SECRETS_BACKEND=fernet
ADMIN_SECRET_KEY=              # launcher lokal mengisi; mode Fernet wajib stabil
# Opsional key khusus dokumen (>=32 karakter). Bila kosong, diturunkan secara
# per-tenant dari ADMIN_SECRET_KEY. Mengganti key tanpa migrasi membuat file lama tak terbaca.
# DOCUMENT_ENCRYPTION_KEY=
# Vault (hanya kalau SECRETS_BACKEND=vault):
# VAULT_ADDR=http://127.0.0.1:8200
# VAULT_TOKEN=                    # dev saja; production menolak static token
# VAULT_ROLE_ID=                  # production: AppRole short-lived
# VAULT_SECRET_ID=
# VAULT_KV_MOUNT=secret
# VAULT_BASE_PATH=tenantos
# VAULT_CACHE_TTL=300

# --- Vector store dokumen (pgvector) ----------------------------------------
# Poros memakai pgvector untuk pencarian dokumen. Butuh Postgres+pgvector nyala:
#     docker compose -f deploy/pgvector/docker-compose.yml up -d
# Postgres utama (:5432/poros) tetap sumber kebenaran teks/ACL; ini cuma mirror
# vektor (:5433/poros_vec) untuk pencarian cepat (indeks HNSW). Kalau container
# mati, ingest tetap jalan & pencarian otomatis balik ke scan (aman).
# VECTOR_PG_DIM harus sama dengan dimensi embedder (MiniLM=384, e5-base=768, bge-m3=1024).
VECTOR_BACKEND=sqlite
# Aktifkan hanya setelah extension/service pgvector tersedia:
# VECTOR_PG_DSN=                       # isi DSN rahasia di .env lokal / secret manager
VECTOR_PG_DIM=384
VECTOR_PG_TABLE=doc_chunks_vec

# --- Embedding & rerank (kualitas doc-RAG) ----------------------------------
# ST_EMBED_MODEL=paraphrase-multilingual-MiniLM-L12-v2
# ST_EMBED_DISABLE=1          # paksa embedder offline (tanpa unduh model)
# RAG_RERANK=1
# RAG_RERANK_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1

# --- BigQuery keyless (opsional) --------------------------------------------
# GOOGLE_APPLICATION_CREDENTIALS=

# --- Lain-lain --------------------------------------------------------------
# DOCS_FILES_DIR=backend/app/files        # lokasi file dokumen asli (sitasi klik-able)
# DOCUMENT_MAX_UPLOAD_MB=25               # batas satu upload
# DOCUMENT_TENANT_QUOTA_MB=250            # total original file per tenant
# ADMIN_SAMPLE_DB=backend/app/sample_acme.duckdb
# RATE_LIMIT_PER_MIN=120
# Custom LLM api_base: localhost otomatis boleh di dev. Production wajib exact allowlist.
# LLM_API_BASE_ALLOWLIST=https://internal-llm.example.com:443
# LLM_ALLOW_PRIVATE_BASE=0                 # 1 untuk private/internal host yang disetujui
# LLM_ALLOW_INSECURE_BASE=0                # 1 hanya bila production internal memang HTTP
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# EXPOSE_API_DOCS=1            # default dev=aktif, production=nonaktif
