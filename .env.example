# DevOps Platform Integration
APP_NAME=poros-ai
DEVOPS_PLATFORM_INTEGRATION=true
LLM_ENGINE_URL=http://llm-reasoning-engine.unified-devops-platform.svc.cluster.local:8080

# Console browser is routed through Apps Gateway by .platform/routing.yaml.
# The platform injects authenticated email as X-User-Id and must not expose the
# backend Service directly. These values are deployment flags, not secrets.
APPS_GATEWAY_TRUST_HEADER=1
APPS_GATEWAY_NETWORK_ISOLATED=1
APPS_GATEWAY_AUTO_PROVISION=1
APPS_GATEWAY_DEFAULT_ROLE=tenant_manager
